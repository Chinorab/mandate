# Copy to .env.local and fill in. Never commit real values.
# PayPal sandbox only (docs/sandbox-setup.md)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID_SPORTS_OUTLET=
PAYPAL_MERCHANT_ID_RUNNING_CO=
PAYPAL_MERCHANT_ID_SHOE_SUPPLY=

# Anthropic (set a monthly spend limit on this key)
ANTHROPIC_API_KEY=
MODEL_DAILY_GLOBAL_CAP=

# Postgres
DATABASE_URL=

# Signs the demo session cookie (32+ random bytes)
SESSION_SECRET=

# AG Studio license key (45 day trial, activate on or after 2026-11-01)
AG_STUDIO=

# Render Workflows
RENDER_API_KEY=

# Playwright sandbox buyer (local e2e only)
E2E_BASE_URL=
E2E_PAYPAL_BUYER_EMAIL=
E2E_PAYPAL_BUYER_PASSWORD=

# Development only: enables POST /api/dev/scenario for end to end tests (never in production)
MANDATE_DEV_SCENARIOS=
